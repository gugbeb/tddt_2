            RowBox[{"y", "[", 
             RowBox[{"\[Tau]", ",", "j"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"shape", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "0", ",", "t"}], "}"}]}], "]"}]}], "==", 
      RowBox[{"q", "[", 
       RowBox[{"t", ",", "i"}], "]"}]}], ",", 
