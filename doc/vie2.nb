Cell[TextData[{
 "Solving a convolution-type equation",
 StyleBox[" ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"i", ",", "j"}]], "[", "t", "]"}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"k", ",", "l"}]], 
     RowBox[{
      UnderoverscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"\[DifferentialD]", "\[Tau]"}], " ", 
       RowBox[{
        SubscriptBox["K", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l"}]], "[", 
        RowBox[{"t", "-", "\[Tau]"}], "]"}], 
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"k", ",", "l"}]], "[", "\[Tau]", "]"}]}]}]}]}], "=", 
   RowBox[{
    SubscriptBox["q", 
     RowBox[{"i", ",", "j"}]], "[", "t", "]"}]}]], "DisplayFormula",
  ExpressionUUID->"0ebbe7ce-e4b3-47b5-8ee5-9344ef011d21"], "DisplayFormula"],
 StyleBox[" ", "DisplayFormula"],
 "by means of the Laplace transform."
}], "Text",
 CellChangeTimes->{
  3.888646493542735*^9, {3.8886465426658163`*^9, 3.8886465868020897`*^9}, {
   3.8886481648272247`*^9, 3.888648165837201*^9}, {3.888648287049757*^9, 
