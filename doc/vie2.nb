Cell[TextData[{
 "Solving a convolution-type equation",
 StyleBox[" ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"i", ",", "j"}]], "[", 
     RowBox[{
      SubscriptBox["t", "1"], "-", 
      SubscriptBox["t", "2"]}], "]"}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], 
     RowBox[{
      UnderoverscriptBox["\[Integral]", 
       SubscriptBox["t", "2"], 
       SubscriptBox["t", "1"]], 
      RowBox[{
       RowBox[{"\[DifferentialD]", "\[Tau]"}], " ", 
       RowBox[{
        SubscriptBox["f", 
         RowBox[{"i", ",", "k"}]], "[", 
        RowBox[{
         SubscriptBox["t", "1"], "-", "\[Tau]"}], "]"}], 
       RowBox[{
        SubscriptBox["g", 
         RowBox[{"k", ",", "j"}]], "[", 
        RowBox[{"\[Tau]", "-", 
         SubscriptBox["t", "2"]}], "]"}]}]}]}]}], "=", 
   RowBox[{
    SubscriptBox["q", 
     RowBox[{"i", ",", "j"}]], "[", 
    RowBox[{
     SubscriptBox["t", "1"], "-", 
     SubscriptBox["t", "2"]}], "]"}]}]], "DisplayFormula",ExpressionUUID->
  "f61599d4-c701-4bcb-8711-8b4bdf9780b9"], "DisplayFormula"],
 StyleBox[" ", "DisplayFormula"],
 "by means of the Laplace transform."
}], "Text",
 CellChangeTimes->{
  3.888646493542735*^9, {3.8886465426658163`*^9, 3.8886465868020897`*^9}, {
   3.8886481648272247`*^9, 3.888648165837201*^9}, {3.888648287049757*^9, 
