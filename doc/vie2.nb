  RowBox[{"(*", " ", 
   RowBox[{
   "Ranges", " ", "of", " ", "indices", " ", "i", " ", "and", " ", "j"}], " ",
    "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"K", "[", 
    RowBox[{
    "t_", ",", "\[Tau]_", ",", "i_", ",", "j_", ",", "k_", ",", "l_"}], "]"}],
    ":=", 
   RowBox[{
    RowBox[{"(", 
