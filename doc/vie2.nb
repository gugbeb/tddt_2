Cell[BoxData[{
 RowBox[{
  RowBox[{"solution", "=", 
   RowBox[{"InverseLaplaceTransform", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"-", "\[ImaginaryI]"}], 
          RowBox[{"s", "+", "\[ImaginaryI]"}]]}], ")"}], 
       RowBox[{"-", "1"}]], 
