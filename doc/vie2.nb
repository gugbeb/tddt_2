 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"i", ",", "j"}]], "[", "t", "]"}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"k", ",", "l"}]], 
