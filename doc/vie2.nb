Cell[TextData[{
 "Solving a causal convolution-type equation",
 StyleBox[" ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{
      SubscriptBox["t", "1"], "-", 
      SubscriptBox["t", "2"]}], "]"}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Integral]", 
      SubscriptBox["t", "2"], 
      SubscriptBox["t", "1"]], 
     RowBox[{
      RowBox[{"\[DifferentialD]", "\[Tau]"}], " ", 
      RowBox[{"f", "[", 
       RowBox[{
        SubscriptBox["t", "1"], "-", "\[Tau]"}], "]"}], 
      RowBox[{"g", "[", 
       RowBox[{"\[Tau]", "-", 
        SubscriptBox["t", "2"]}], "]"}]}]}]}], "=", 
   RowBox[{"q", "[", 
    RowBox[{
     SubscriptBox["t", "1"], "-", 
     SubscriptBox["t", "2"]}], "]"}]}]], "DisplayFormula",ExpressionUUID->
  "6c550f1f-a7fe-4c52-8fd0-eab9c17cfd0f"], "DisplayFormula"],
 StyleBox[" ", "DisplayFormula"],
 "by means of the Laplace transform."
}], "Text",
 CellChangeTimes->{
  3.888646493542735*^9, {3.8886465426658163`*^9, 3.8886465868020897`*^9}, {
