        RowBox[{
         RowBox[{"y", "[", "i", "]"}], "==", 
         SubscriptBox["y", "i"]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "k"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        SubscriptBox["p", "l"], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", "k"}], "}"}]}], "]"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"II", "[", 
     RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "[", "x", "]"}], "/.", "P"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "m", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
