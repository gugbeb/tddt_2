Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RHSl", "[", 
    RowBox[{"t1_", ",", "t2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Ql", "[", 
     RowBox[{"t1", ",", "t2"}], "]"}], "-", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Fl", "[", 
        RowBox[{"t1", ",", "\[Tau]"}], "]"}], 
       RowBox[{"Ga", "[", 
        RowBox[{"\[Tau]", ",", "t2"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "t2"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"t2", ">=", "0"}], ",", 
         RowBox[{"t1", ">=", "0"}]}], "}"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"RHSl", "[", 
     RowBox[{"t1", ",", "t2"}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], 
     FractionBox["1", "100"], "  ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", 
        SqrtBox["5"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "t1"}], "-", 
            RowBox[{"\[Lambda]2", " ", "t2"}]}], ")"}]}]]}], "-", 
       RowBox[{"4", " ", 
        SqrtBox["5"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "t1"}], "-", 
            RowBox[{"\[Lambda]1", " ", "t2"}]}], ")"}]}]]}], "-", 
       RowBox[{"5", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SqrtBox["5"]}], ")"}], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          RowBox[{"(", 
           RowBox[{"t1", "-", 
            RowBox[{"\[Lambda]2", " ", "t2"}]}], ")"}]}]]}], "-", 
       RowBox[{"5", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SqrtBox["5"]}], ")"}], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
          RowBox[{"(", 
           RowBox[{"t1", "-", 
            RowBox[{"\[Lambda]1", " ", "t2"}]}], ")"}]}]]}]}], ")"}]}]}], 
   "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gl", "[", 
    RowBox[{"t1_", ",", "t2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], 
    FractionBox["1", "100"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]1", " ", "t1"}], "-", " ", 
           RowBox[{"\[Lambda]2", " ", "t2"}]}], ")"}]}]]}], " ", "+", 
      RowBox[{"2", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", " ", "\[ImaginaryI]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]2", " ", "t1"}], "-", " ", 
