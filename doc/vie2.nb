Cell[TextData[{
 "Solving a convolution-type equation ",
 StyleBox[" ", "DisplayFormula"],
 StyleBox[Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["y", "i"], "[", "t", "]"}], "+", 
    RowBox[{
     UnderscriptBox["\[Sum]", "j"], 
     RowBox[{
      UnderoverscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"\[DifferentialD]", "\[Tau]"}], " ", 
       RowBox[{
        SubscriptBox["K", 
         RowBox[{"i", ",", "j"}]], "[", 
        RowBox[{"t", "-", "\[Tau]"}], "]"}], 
       RowBox[{
        SubscriptBox["y", "j"], "[", "\[Tau]", "]"}]}]}]}]}], "=", 
   RowBox[{
    SubscriptBox["q", "i"], "[", "t", "]"}]}]], "DisplayFormula",
  ExpressionUUID->"d75f82ed-f251-4ecf-ae8b-c1c64b72c64c"], "DisplayFormula"],
 StyleBox[" ", "DisplayFormula"],
 "by means of the Laplace transform."
}], "Text",
